{
  "regimes": {
    "TIGHT_DRIFT": {
      "priority": 1,
      "override": true,
      "select_stacks": [
        "S1",
        "S2"
      ],
      "conditions": [
        "spread is tight (W <= W_p25)",
        "|m_norm| >= trend_abs_m_norm_min",
        "eff_order_ok == true",
        "direction consensus across >=2 valid stacks"
      ],
      "decision": "trend = sign(m) (Bull if +, Bear if -)",
      "confidence_adjustments": {
        "stage_factor": 1.05,
        "notes": "Strong unison drift; can override most guardrails unless explicitly DISORDER."
      },
      "expr": {
        "when": [
          "get('hyst.stacks.S1.W_now', 0.0) <= get('hyst.stacks.S1.W_p25', 0.0)",
          "abs(get('hyst.stacks.S1.m_norm', 0.0)) >= get('thresholds.drift.trend_abs_m_norm_min', 1.0)",
          "get('hyst.stacks.S1.eff_order', 0.0) >= 0.6",
          "sign(get('hyst.stacks.S1.m', 0.0)) == sign(get('hyst.stacks.S2.m', 0.0))"
        ],
        "trend": "'Bull' if get('hyst.stacks.S1.m', 0.0) > 0 else 'Bear'",
        "confidence": "clamp(abs(get('hyst.stacks.S1.m_norm',0.0))/3.0 * 1.05, 0.0, 1.0)",
        "reason": "'TIGHT_DRIFT'",
        "scores": {
          "bull": "clamp(max(get('hyst.stacks.S1.m_norm',0.0),0.0)/3.0,0,1)",
          "bear": "clamp(max(-get('hyst.stacks.S1.m_norm',0.0),0.0)/3.0,0,1)",
          "neutral": "0.0",
          "reversal": "0.0"
        }
      }
    },
    "FAN_EXPAND": {
      "priority": 2,
      "override": false,
      "conditions": [
        "spread is fanned (W >= W_p75)",
        "expand (dW_norm > +1.0) on >=1 of [S0,S1,S2]",
        "eff_order_ok == true for direction-consistent order",
        "sign(m) agrees with order direction"
      ],
      "decision": "trend = sign(m)",
      "confidence_adjustments": {
        "stage_factor": 1.0
      },
      "expr": {
        "when": [
          "get('hyst.stacks.S1.W_now', 0.0) >= get('hyst.stacks.S1.W_p75', 0.0)",
          "get('hyst.stacks.S1.dW_norm', 0.0) > 1.0 or get('hyst.stacks.S0.dW_norm',0.0) > 1.0 or get('hyst.stacks.S2.dW_norm',0.0) > 1.0",
          "get('hyst.stacks.S1.eff_order', 0.0) >= 0.5"
        ],
        "trend": "'Bull' if get('hyst.stacks.S1.m', 0.0) > 0 else 'Bear'",
        "confidence": "clamp(abs(get('hyst.stacks.S1.m_norm',0.0))/3.0, 0.0, 1.0)",
        "reason": "'FAN_EXPAND'"
      }
    },
    "FAN_COLLAPSE": {
      "priority": 3,
      "override": false,
      "conditions": [
        "spread above median baseline (W_pct >= 50)",
        "collapse (dW_norm < -1.0) on >=1 of [S0,S1,S2]",
        "eff_order_ok remains true OR only mildly degraded",
        "trend direction still has ladder consensus"
      ],
      "decision": "trend = sign(m) (continuation bias) but runway shorter",
      "confidence_adjustments": {
        "stage_factor": 0.8
      },
      "expr": {
        "when": [
          "get('hyst.stacks.S1.W_pct', 0.0) >= 50.0",
          "get('hyst.stacks.S1.dW_norm', 0.0) < -1.0 or get('hyst.stacks.S0.dW_norm',0.0) < -1.0 or get('hyst.stacks.S2.dW_norm',0.0) < -1.0",
          "get('hyst.stacks.S1.eff_order', 0.0) >= 0.4"
        ],
        "trend": "'Bull' if get('hyst.stacks.S1.m', 0.0) > 0 else 'Bear'",
        "confidence": "clamp(abs(get('hyst.stacks.S1.m_norm',0.0))/3.0 * 0.8, 0.0, 1.0)",
        "reason": "'FAN_COLLAPSE'"
      }
    },
    "DISORDER": {
      "priority": 4,
      "override": false,
      "conditions": [
        "cross_rate in top quartile baseline OR eff_order_ok == false on most stacks OR stacks disagree on direction"
      ],
      "decision": "trend = Neutral",
      "confidence_adjustments": {
        "stage_factor": 0.5
      },
      "expr": {
        "when": [
          "get('hyst.stacks.S1.cross_rate', 0.0) > 3.0 or get('hyst.stacks.S1.eff_order', 0.0) < 0.25"
        ],
        "trend": "'Neutral'",
        "confidence": "0.0",
        "reason": "'DISORDER'",
        "scores": {
          "neutral": "1.0",
          "bull": "0.0",
          "bear": "0.0",
          "reversal": "0.0"
        }
      }
    },
    "FLAT_NEUTRAL": {
      "priority": 5,
      "override": false,
      "conditions": [
        "spread is tight on most stacks",
        "|m_norm| <= flat_abs_m_norm_max on most stacks"
      ],
      "decision": "trend = Neutral",
      "confidence_adjustments": {
        "stage_factor": 0.6
      },
      "expr": {
        "when": [
          "get('hyst.stacks.S1.W_now', 0.0) <= get('hyst.stacks.S1.W_p25', 0.0)",
          "abs(get('hyst.stacks.S1.m_norm', 0.0)) <= get('thresholds.drift.flat_abs_m_norm_max', 0.5)"
        ],
        "trend": "'Neutral'",
        "confidence": "0.0",
        "reason": "'FLAT_NEUTRAL'",
        "scores": {
          "neutral": "1.0",
          "bull": "0.0",
          "bear": "0.0",
          "reversal": "0.0"
        }
      }
    }
  },
  "fusion": {
    "valid_stack_criteria": [
      "has all sigma series present",
      "tail window contains enough samples",
      "not flagged as DISORDER by extreme cross_rate (optional soft exclusion)"
    ],
    "direction_vote": {
      "dir_i": "sign(m_i) with 0 if |m_norm_i| < flat_abs_m_norm_max",
      "quality_i": "Q_i in [0,1] derived from |m_norm|, eff_order, W_pct, and cross_rate",
      "quality_formula": "sigmoid(a1*|m_norm| + a2*eff_order_z + a3*W_pct_z - a4*cross_rate_z)",
      "vote": "sum(w_vote_i * dir_i * Q_i)",
      "vote_norm": "abs(vote) / sum(w_vote_i * Q_i + eps)"
    },
    "confidence": {
      "base": "vote_norm",
      "ladder_cap": "drop_penalty_caps[best_valid_stack_id]",
      "stage_factor": "from selected regime",
      "final": "clamp(base * ladder_cap * stage_factor, 0, 1)"
    },
    "best_valid_stack_selection": {
      "rule": "choose the highest-resolution stack among valid stacks in order S0,S1,S2,S3",
      "purpose": "caps confidence when more sensitive sigmas are unavailable or too noisy"
    }
  },
  "probe_logic": {
    "pair": [
      23,
      83
    ],
    "role": "early collapse/exhaustion warning inside episode",
    "signals": [
      {
        "name": "PROBE_FLIP_EARLY",
        "definition": "sign flip in d_probe occurs while d_primary has not flipped",
        "effect": "reduce confidence and shorten ETA; mark 'flip_watch' true"
      },
      {
        "name": "PROBE_FAST_COLLAPSE",
        "definition": "abs(d_probe) shrinking rapidly (d|d_probe|/dt strongly negative) while primary still trending",
        "effect": "reduce confidence; bias regime toward FAN_COLLAPSE"
      }
    ],
    "penalties": {
      "confidence_multiplier": 0.85,
      "eta_multiplier": 0.8
    }
  },
  "notes": {
    "update_2026_03_04": "Regime gates now use W_pct (width percentile) instead of missing W_p25/W_p75 fields."
  }
}